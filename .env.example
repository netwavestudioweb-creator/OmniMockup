# ==============================================================================
# OmniMockup Studio - Configuration d'Environnement
# ==============================================================================

# Clé API Google Gemini pour l'analyse intelligente de pages web
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# SUPABASE (Authentification, profils et quotas)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# STRIPE (Paiements, abonnements et webhooks)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Identifiants de tarifs Stripe (générés via npm run setup-stripe)
STRIPE_PRO_PRICE_ID=price_pro_example_id
STRIPE_AGENCE_PRICE_ID=price_agence_example_id

# ------------------------------------------------------------------------------
# SASPAY (Mobile Money & carte en FCFA — https://docs.saspay.me)
# Clé API : tableau de bord SasPay → Développeur (scope PAYIN suffit).
# Secret webhook : affiché UNE SEULE FOIS à la création du webhook
# (URL : https://<votre-site>/api/payments/saspay/webhook, event transaction.success)
# ------------------------------------------------------------------------------
SASPAY_SECRET_KEY=sk_test_your_saspay_secret_key
SASPAY_WEBHOOK_SECRET=your_saspay_webhook_signing_secret

# URL du site pour les redirections
NEXT_PUBLIC_SITE_URL=http://localhost:3000
